# Service worker and manifest must always revalidate so PWA updates roll out.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/index.html
  Cache-Control: no-cache

# Content-hashed build output is immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' blob: https://cloudflareinsights.com https://accounts.google.com/gsi/ https://*.nationalmap.gov https://tiles.openfreemap.org https://services3.arcgis.com https://fwspublicservices.wim.usgs.gov https://dnrmaps.wi.gov https://s3-us-west-2.amazonaws.com https://api.open-meteo.com; img-src 'self' data: blob: https://*.googleusercontent.com https://*.nationalmap.gov https://tiles.openfreemap.org https://fwspublicservices.wim.usgs.gov https://dnrmaps.wi.gov; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
