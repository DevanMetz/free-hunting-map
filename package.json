{
  "name": "open-hunt-map",
  "version": "0.1.0",
  "description": "Free, open-source, offline-first hunting and camping map (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "predev": "node scripts/prepare-lidar.mjs",
    "prebuild": "node scripts/prepare-lidar.mjs"
  },
  "author": "Devan Metz",
  "license": "MIT",
  "dependencies": {
    "copc": "^0.0.9",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "laz-perf": "^0.0.7",
    "maplibre-gl": "^6.15.0",
    "onnxruntime-web": "^1.30.0",
    "proj4": "^2.22.0",
    "qrcode": "^1.5.4",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  },
  "private": true,
  "type": "module"
}
