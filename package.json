{
  "name": "open-hunt-map",
  "version": "0.1.0",
  "description": "Free, open-source, offline-first hunting and camping map (PWA).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs"
  },
  "author": "Devan Metz",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.15.0",
    "qrcode": "^1.5.4",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
